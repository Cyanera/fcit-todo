# ── صندوق الوارد ─────────────────────────────────────────────
# true = القروب المراقَب صندوق تحوّل إليه الرسائل يدويًا، وكل رسالة
# تصل تُعتبر مهمة بلا تخمين. البوت لا يقرأ أي قروب آخر إطلاقًا.
# الاستثناء الوحيد: رسالة فارغة أو إيموجي وحده.
INBOX_MODE=false

# ── وضع التشغيل ──────────────────────────────────────────────
# auto   = ذكي إذا كان فيه مفتاح صالح، وإلا قواعد (الافتراضي)
# rules  = قواعد دائمًا — بدون API وبدون أي تكلفة
# claude = ذكي دائمًا — يفشل عند الإقلاع لو ما فيه مفتاح
MODE=auto

# رسائلك أنت تُتجاهل افتراضيًا (ما تكتبه ليس طلبًا عليك).
# فعّلها بـ true لو تبغى تجرّب البوت وحدك في قروب اختبار.
INCLUDE_OWN_MESSAGES=false

# كلمات إضافية يعتبرها وضع القواعد إشارة طلب، مفصولة بفاصلة.
# أضف هنا ما يتكرر في قروبك تحديدًا.
RULE_KEYWORDS=

# ── مفتاح Claude ─────────────────────────────────────────────
# من https://console.anthropic.com/settings/keys
# اتركه كما هو لو ما عندك رصيد — البوت يشتغل بوضع القواعد تلقائيًا.
ANTHROPIC_API_KEY=sk-ant-...

# الموديل المستخدم للتصنيف.
# claude-opus-5   الأدق (الافتراضي)
# claude-sonnet-5 أرخص ~2.5x وسريع — مناسب لو القروب كثير الحركة
# claude-haiku-4-5 الأرخص
CLAUDE_MODEL=claude-opus-5

# مستوى الجهد: low للتصنيف السريع، medium أدق شوي
CLAUDE_EFFORT=low

# ── هويتك في القروب ──────────────────────────────────────────
# اسمك ولقبك وكل صيغة ينادونك فيها، مفصولة بفاصلة.
# تُستخدم لرفع ثقة المهام الموجّهة لك بالاسم — والمهام الجماعية تُلتقط
# بدونها أصلًا، فلا تقلق لو تركتها ناقصة.
MY_NAMES=عهد,د. عهد,دكتورة عهد,Ahad

# أسماء الزملاء في القروب — أي رسالة موجّهة لأحدهم تُستبعد من مهامك.
# مهم في وضع القواعد لتقليل الضجيج.
OTHER_NAMES=خالد,سارة,فهد,منى

# رقمك بصيغة دولية بدون + (اتركه فاضي ليأخذه تلقائيًا من الجلسة)
MY_NUMBER=

# ── القروب ───────────────────────────────────────────────────
# شغّل: npm run groups  بعد تسجيل الدخول عشان تطلع لك قائمة القروبات ومعرّفاتها
# تقدر تحط أكثر من قروب مفصولين بفاصلة
GROUP_JIDS=

# ── سلوك المعالجة ────────────────────────────────────────────
# كل كم ثانية يجمّع الرسائل ويرسلها دفعة وحدة لـ Claude
FLUSH_INTERVAL_SECONDS=60
# أو يرسل مباشرة لو تجمّع هذا العدد من الرسائل
FLUSH_MAX_MESSAGES=25
# الحد الأدنى للثقة عشان تُسجّل المهمة (0 إلى 1)
MIN_CONFIDENCE=0.6

# ── التنبيهات ────────────────────────────────────────────────
# يرسل لك تنبيه على "رسالة لنفسي" في واتساب للمهام العاجلة
NOTIFY_URGENT=true
# ملخص يومي، بصيغة HH:MM بتوقيت TZ (اتركه فاضي للتعطيل)
DAILY_DIGEST_AT=07:30

TZ=Asia/Riyadh

# ── اللوحة ───────────────────────────────────────────────────
PORT=3777

# مسار قاعدة بيانات بديل — للاختبار على نسخة منفصلة دون المساس
# بقاعدة النسخة العاملة. اتركه فاضيًا للاستخدام العادي.
DB_PATH=
