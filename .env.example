# ── مفتاح Claude ─────────────────────────────────────────────
# من https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# الموديل المستخدم للتصنيف.
# claude-opus-5   الأدق (الافتراضي)
# claude-sonnet-5 أرخص ~2.5x وسريع — مناسب لو القروب كثير الحركة
# claude-haiku-4-5 الأرخص
CLAUDE_MODEL=claude-opus-5

# مستوى الجهد: low للتصنيف السريع، medium أدق شوي
CLAUDE_EFFORT=low

# ── هويتك في القروب ──────────────────────────────────────────
# اسمك ولقبك وكل صيغة ينادونك فيها، مفصولة بفاصلة.
# مهمة جدًا لدقة التصنيف — اكتب كل الصيغ المستخدمة فعليًا.
MY_NAMES=أحد,د. أحد,دكتور أحد,ابو ...,Ahad

# رقمك بصيغة دولية بدون + (اتركه فاضي ليأخذه تلقائيًا من الجلسة)
MY_NUMBER=

# ── القروب ───────────────────────────────────────────────────
# شغّل: npm run groups  بعد تسجيل الدخول عشان تطلع لك قائمة القروبات ومعرّفاتها
# تقدر تحط أكثر من قروب مفصولين بفاصلة
GROUP_JIDS=

# ── سلوك المعالجة ────────────────────────────────────────────
# كل كم ثانية يجمّع الرسائل ويرسلها دفعة وحدة لـ Claude
FLUSH_INTERVAL_SECONDS=60
# أو يرسل مباشرة لو تجمّع هذا العدد من الرسائل
FLUSH_MAX_MESSAGES=25
# الحد الأدنى للثقة عشان تُسجّل المهمة (0 إلى 1)
MIN_CONFIDENCE=0.6

# ── التنبيهات ────────────────────────────────────────────────
# يرسل لك تنبيه على "رسالة لنفسي" في واتساب للمهام العاجلة
NOTIFY_URGENT=true
# ملخص يومي، بصيغة HH:MM بتوقيت TZ (اتركه فاضي للتعطيل)
DAILY_DIGEST_AT=07:30

TZ=Asia/Riyadh

# ── اللوحة ───────────────────────────────────────────────────
PORT=3777
